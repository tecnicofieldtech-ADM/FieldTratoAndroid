procedure PostFabricacao(Req: THorseRequest; Res: THorseResponse; Next: TProc);
var
  Body: TJSONObject;
  Itens: TJSONArray;
  Item: TJSONObject;
  Q: TFDQuery;
  Conn: TFDConnection;
  I: Integer;

  IdLocalFab: string;
  HandoffId: string;
  IdServidorFab: Integer;

  IdFazenda: Integer;
  IdDieta: Integer;
  IdUsuario: Integer;
  IdOperador: Integer;
  DataFab: TDate;
  QtdePrevista: Double;
  QtdeRealizada: Double;

  IdInsumo: Integer;
  QtdePrevistaItem: Double;
  QtdeRealizadaItem: Double;
  MsInsumo: Double;
  IdUsuarioItem: Integer;

  RespJson: TJSONObject;
  RespItens: TJSONArray;
  RespItem: TJSONObject;
begin
  Body := nil;
  Q := nil;
  RespJson := nil;
  RespItens := nil;
  Conn := nil;

  try
    Body := TJSONObject.ParseJSONValue(Req.Body) as TJSONObject;
    if not Assigned(Body) then
      raise Exception.Create('JSON inválido.');

    IdLocalFab    := JSONStr(Body, 'id');
    HandoffId     := JSONStr(Body, 'handoff_id');
    IdFazenda     := StrToIntSafe(JSONStr(Body, 'id_fazenda'));
    IdDieta       := StrToIntSafe(JSONStr(Body, 'id_dieta'));
    IdUsuario     := StrToIntSafe(JSONStr(Body, 'id_usuario'));
    IdOperador    := StrToIntSafe(JSONStr(Body, 'id_operador'));
    DataFab       := StrToDateBR(JSONStr(Body, 'data'));
    QtdePrevista  := StrToFloatBR(JSONStr(Body, 'qtde_prevista'));
    QtdeRealizada := StrToFloatBR(JSONStr(Body, 'qtde_realizada'));
    Itens         := JSONArray(Body, 'itens');

    if IdFazenda <= 0 then
      raise Exception.Create('Campo id_fazenda inválido.');
    if IdDieta <= 0 then
      raise Exception.Create('Campo id_dieta inválido.');
    if IdUsuario <= 0 then
      raise Exception.Create('Campo id_usuario inválido.');

    Conn := dmFieldPec.FBCon;

    if not Conn.Connected then
      Conn.Connected := True;

    if not Conn.InTransaction then
      Conn.StartTransaction;

    try
      Q := TFDQuery.Create(nil);
      try
        Q.Connection := Conn;
        Q.SQL.Text :=
          'INSERT INTO FABRICACAO ( ' +
          '  IDRACAO, DATA_FAB, KG_PREVISTO, KG_REALIZADO, ' +
          '  ID_USUARIO, ID_OPERADOR, ID_PROPRIEDADE, ORIGEM_DADOS, STATUS, DATAREG ' +
          ') VALUES ( ' +
          '  :IDRACAO, :DATA_FAB, :KG_PREVISTO, :KG_REALIZADO, ' +
          '  :ID_USUARIO, :ID_OPERADOR, :ID_PROPRIEDADE, 1, 1, CURRENT_TIMESTAMP ' +
          ') RETURNING ID';

        Q.ParamByName('IDRACAO').AsInteger := IdDieta;
        Q.ParamByName('DATA_FAB').AsDate := DataFab;
        Q.ParamByName('KG_PREVISTO').AsFloat := QtdePrevista;
        Q.ParamByName('KG_REALIZADO').AsFloat := QtdeRealizada;
        Q.ParamByName('ID_USUARIO').AsInteger := IdUsuario;
        Q.ParamByName('ID_OPERADOR').AsInteger := IdOperador;
        Q.ParamByName('ID_PROPRIEDADE').AsInteger := IdFazenda;

        Q.Open;
        IdServidorFab := Q.FieldByName('ID').AsInteger;
      finally
        FreeAndNil(Q);
      end;

      if Assigned(Itens) and (Itens.Count > 0) then
      begin
        for I := 0 to Itens.Count - 1 do
        begin
          if not (Itens.Items[I] is TJSONObject) then
            Continue;

          Item := TJSONObject(Itens.Items[I]);

          IdInsumo := StrToIntSafe(JSONStr(Item, 'id_insumo'));
          QtdePrevistaItem := StrToFloatBR(JSONStr(Item, 'qtde_prevista'));
          QtdeRealizadaItem := StrToFloatBR(JSONStr(Item, 'qtd_realizada'));
          MsInsumo := StrToFloatBR(JSONStr(Item, 'ms_insumo'));
          IdUsuarioItem := StrToIntSafe(JSONStr(Item, 'id_usuario'), IdUsuario);

          if IdInsumo <= 0 then
            raise Exception.CreateFmt('Item %d com id_insumo inválido.', [I + 1]);

          Q := TFDQuery.Create(nil);
          try
            Q.Connection := Conn;
            Q.SQL.Text :=
              'INSERT INTO FABRICACAO_INSUMOS ( ' +
              '  ID_FABRICACAO, ID_ALIMENTO, DATA_FAB, MS_INSUMO, ' +
              '  KG_PREVISTO, KG_FABRICADO, ID_USUARIO, STATUS, DATAREG ' +
              ') VALUES ( ' +
              '  :ID_FABRICACAO, :ID_ALIMENTO, :DATA_FAB, :MS_INSUMO, ' +
              '  :KG_PREVISTO, :KG_FABRICADO, :ID_USUARIO, 1, CURRENT_TIMESTAMP ' +
              ')';

            Q.ParamByName('ID_FABRICACAO').AsInteger := IdServidorFab;
            Q.ParamByName('ID_ALIMENTO').AsInteger := IdInsumo;
            Q.ParamByName('DATA_FAB').AsDate := DataFab;
            Q.ParamByName('MS_INSUMO').AsFloat := MsInsumo;
            Q.ParamByName('KG_PREVISTO').AsFloat := QtdePrevistaItem;
            Q.ParamByName('KG_FABRICADO').AsFloat := QtdeRealizadaItem;
            Q.ParamByName('ID_USUARIO').AsInteger := IdUsuarioItem;

            Q.ExecSQL;
          finally
            FreeAndNil(Q);
          end;
        end;
      end;

      Conn.Commit;

      RespJson := TJSONObject.Create;
      RespItens := TJSONArray.Create;

      RespJson.AddPair('success', TJSONBool.Create(True));
      RespJson.AddPair('message', 'Fabricação salva com sucesso.');
      RespJson.AddPair('id_local', IdLocalFab);
      RespJson.AddPair('id_servidor', TJSONNumber.Create(IdServidorFab));
      RespJson.AddPair('handoff_id', HandoffId);
      RespJson.AddPair('itens', RespItens);

      if Assigned(Itens) then
      begin
        for I := 0 to Itens.Count - 1 do
        begin
          if not (Itens.Items[I] is TJSONObject) then
            Continue;

          Item := TJSONObject(Itens.Items[I]);

          RespItem := TJSONObject.Create;
          RespItem.AddPair('id_local', JSONStr(Item, 'id'));
          RespItem.AddPair('status', 'processado');
          RespItens.AddElement(RespItem);
        end;
      end;

      Res.Status(201).Send<TJSONObject>(RespJson);
      RespJson := nil;
    except
      on E: Exception do
      begin
        if Assigned(Conn) and Conn.InTransaction then
          Conn.Rollback;

        RespJson := TJSONObject.Create;
        RespJson.AddPair('success', TJSONBool.Create(False));
        RespJson.AddPair('message', 'Erro ao salvar fabricação.');
        RespJson.AddPair('error', E.Message);
        RespJson.AddPair('id_local', IdLocalFab);
        RespJson.AddPair('handoff_id', HandoffId);

        Res.Status(500).Send<TJSONObject>(RespJson);
        RespJson := nil;
      end;
    end;

  finally
    Body.Free;
    Q.Free;
    RespJson.Free;
  end;
end;

end.
