procedure TdmFieldPec.ConectaDBField;
var
  Arquivo: String;
  vVendorLib:string;
begin
  FBCon.Connected := false;
  Arquivo := ExtractFilePath(ParamStr(0))+'ApiConfig.ini';
  if not FileExists(Arquivo) then
  begin
//    ShowMessage('Arquivo ApiConfig.ini não Localizado no seguinte diretorio:'+#13+
//    Arquivo);
    Exit;
  end
  else
  begin
    FBDriver.VendorHome :='';
    vVendorLib :=ExtractFilePath(ParamStr(0))+'fbclient.dll';
    FBDriver.VendorHome := vVendorLib;
    try
      with FBCon do
      begin
       Params.Values['User_name'] :=LerIni(Arquivo,'FIELD','User','');
       Params.Values['Password']  :=LerIni(Arquivo,'FIELD','Password','');
       Params.Values['Port']      :=LerIni(Arquivo,'FIELD','Port','');
       Params.Values['Server']    :=LerIni(Arquivo,'FIELD','Server','');
       Params.Values['Database']  :=LerIni(Arquivo,'FIELD','DB','');
       Connected := True;
      end;
    except
//      ShowMessage('Ocorreu uma Falha na configuração no Banco Firebird!');
    end;
  end;
end;

