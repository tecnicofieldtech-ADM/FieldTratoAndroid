procedure Tdmdb.ConectaDBCGPec;
var
  Arquivo: String;
  vVendorLib:string;
begin
  FBCon.Connected := false;
  Arquivo := ExtractFilePath(ParamStr(0))+'ApiConfig.ini';
  if not FileExists(Arquivo) then
  begin
    ShowMessage('Arquivo ApiConfig.ini não Localizado no seguinte diretorio:'+#13+
    Arquivo);
    Exit;
  end
  else
  begin
    vVendorLib :=ExtractFilePath(ParamStr(0))+'fbclient.dll';
    FBDriver.VendorLib := vVendorLib;
    try
      with FBCon do
      begin
       Params.Values['User_name'] :=LerIni(Arquivo,'CGPEC','User','');
       Params.Values['Password']  :=LerIni(Arquivo,'CGPEC','Password','');
       Params.Values['Port']      :=LerIni(Arquivo,'CGPEC','Port','');
       Params.Values['Server']    :=LerIni(Arquivo,'CGPEC','Server','');
       Params.Values['Database']  :=LerIni(Arquivo,'CGPEC','DB','');
       Connected := True;
      end;
    except
      ShowMessage('Ocorreu uma Falha na configuração no Banco Firebird!');
    end;
  end;
end;

function Tdmdb.LerIni(Diretorio, Chave1, Chave2,
  ValorPadrao: String): String;
var
 FileIni: TIniFile;
begin
  result := ValorPadrao;
  try
    FileIni := TIniFile.Create(Diretorio);
    if FileExists(Diretorio) then
      result := FileIni.ReadString(Chave1, Chave2, ValorPadrao);
  finally
    FreeAndNil(FileIni)
  end;
end;

