unit Controllers.Post;

interface
uses
  Horse,
  Horse.Jhonson,
  Horse.CORS,
  System.JSON,
  System.SysUtils;
  procedure LimpaJSONObject(JSON: TJSONObject);
  procedure RegistraRotas;
  procedure PostFornecimento(Req: THorseRequest; Res: THorseResponse; Next: TProc);
  procedure PostFabricacao(Req: THorseRequest; Res: THorseResponse; Next: TProc);
  procedure PostFabricacaoInsumos(Req: THorseRequest; Res: THorseResponse; Next: TProc);
  function VerificaCampoObrigatorio(const JSON: TJSONObject; const NomeCampo: string; out Valor: string): Boolean;

implementation

uses Udm;

procedure LimpaJSONObject(JSON: TJSONObject);
begin
  while JSON.Count > 0 do
    JSON.RemovePair(JSON.Pairs[0].JsonString.Value);
end;

procedure RegistraRotas;
begin
  THorse.Post('/Post/Fornecimento',PostFornecimento);
  THorse.Post('/Post/Fabricacao',PostFabricacao);
  THorse.Post('/Post/Fabricacao_Insumo',PostFabricacaoInsumos);
end;

function VerificaCampoObrigatorio(const JSON: TJSONObject; const NomeCampo: string; out Valor: string): Boolean;
begin
  Result := JSON.TryGetValue<string>(NomeCampo, Valor) and (Valor.Trim <> '');
end;

procedure PostFornecimento(Req: THorseRequest; Res: THorseResponse; Next: TProc);
var
  dmGlobal: Tdmdb;
  Body: TJSONObject;
  JSONResult: TJSONObject;
  vMaxId, vIdFabricacao, vIdUsuario, vIdTratador, vIdDieta, vRealizado, vMS: string;
begin
  dmGlobal := nil;
  Body := nil;
  JSONResult := nil;

  try
    dmGlobal := Tdmdb.Create(nil);
    dmGlobal.ConectaDBCGPec;

    JSONResult := TJSONObject.Create;
    Body := Req.Body<TJSONObject>;
    if not Assigned(Body) then
      raise Exception.Create('JSON inválido ou corpo vazio');

    if not Body.TryGetValue<string>('id', vMaxId) or (vMaxId.Trim = '') then
      raise Exception.Create('Campo "id" obrigatório');

    Body.TryGetValue<string>('id_fabricacao', vIdFabricacao);
    Body.TryGetValue<string>('id_usuario_lancamento', vIdUsuario);
    Body.TryGetValue<string>('id_tratador', vIdTratador);
    Body.TryGetValue<string>('id_dieta_realizada', vIdDieta);
    Body.TryGetValue<string>('realizado', vRealizado);
    Body.TryGetValue<string>('ms_dieta_realizada', vMS);

    // Defaults
    if vIdFabricacao = '' then vIdFabricacao := '0';
    if vIdUsuario = '' then vIdUsuario := '0';
    if vIdTratador = '' then vIdTratador := '0';
    if vIdDieta = '' then vIdDieta := '0';
    if vRealizado = '' then vRealizado := '0';
    if vMS = '' then vMS := '0';

    with dmGlobal.Fornecimento do
    begin
      Close;
      SQL.Text := 'SELECT * FROM CADASTRO_FORNECIMENTO WHERE ID = :ID';
      ParamByName('ID').AsString := vMaxId;
      Open;

      if IsEmpty then
        raise Exception.Create('Fornecimento não encontrado');

      Edit;
      FieldByName('ID_FABRICACAO').AsString         := vIdFabricacao;
      FieldByName('ID_USUARIO_LANCAMENTO').AsString := vIdUsuario;
      FieldByName('ID_TRATADOR').AsString           := vIdTratador;
      FieldByName('ID_DIETA_REALIZADA').AsString    := vIdDieta;
      FieldByName('REALIZADO').AsFloat              := StrToFloatDef(vRealizado, 0);
      FieldByName('MS_DIETA_REALIZADA').AsFloat     := StrToFloatDef(vMS, 0);
      Post;
      ApplyUpdates;
    end;

    JSONResult.AddPair('id', vMaxId);
    Res.Send(JSONResult).Status(200);

  except
    on E: Exception do
    begin
      if not Assigned(JSONResult) then
        JSONResult := TJSONObject.Create;

      JSONResult.AddPair('erro', 'Erro: ' + E.ClassName + ' - ' + E.Message);
      Res.Send(JSONResult).Status(500);
    end;
  end;

  FreeAndNil(dmGlobal);
//  FreeAndNil(Body);
  FreeAndNil(JSONResult);
end;


procedure PostFabricacaoInsumos(Req: THorseRequest; Res: THorseResponse; Next: TProc);
var
  dmGlobal: TdmDB;
  Body: TJSONObject;
  ItensArray: TJSONArray;
  Item: TJSONObject;
  i: Integer;
  vValorkg: string;
  vValorkgFloat,vDifPercent,vDif,vKGPrevista,vKGRealizado: Double;
  vMaxId, vTempStr,vIdInsumo,vIdFazenda: string;
begin
  Body := Req.Body<TJSONObject>;
  dmGlobal := TdmDB.Create(nil);

  try
    if not Assigned(Body) then
      raise Exception.Create('JSON inválido ou vazio');

    ItensArray := Body.GetValue('itens') as TJSONArray;
    if not Assigned(ItensArray) or (ItensArray.Count = 0) then
      raise Exception.Create('Campo "itens" inválido ou vazio');

    for i := 0 to ItensArray.Count - 1 do
    begin
      Item := ItensArray.Items[i] as TJSONObject;

      if not Item.TryGetValue<string>('id', vMaxId) or (vMaxId.Trim = '') then
        raise Exception.Create('Campo obrigatório "id" não informado');

      if not Item.TryGetValue<string>('id_fabricacao', vTempStr) or (vTempStr.Trim = '') then
        raise Exception.Create('Campo obrigatório "id_fabricacao" não informado');

      if not Item.TryGetValue<string>('id_insumo', vTempStr) or (vTempStr.Trim = '') then
        raise Exception.Create('Campo obrigatório "id_insumo" não informado');

      vKGPrevista  := StrToFloatDef(Item.GetValue<string>('qtde_prevista', '0'), 0);
      vKGRealizado := StrToFloatDef(Item.GetValue<string>('qtd_realizada', '0'), 0);

      vDif := vKGPrevista-vKGRealizado;

      vDifPercent := (vDif*100)/vKGPrevista;

      vIdInsumo   := Item.GetValue<string>('id_insumo', '');
      vIdFazenda  := Item.GetValue<string>('id_fazenda', '');

      vValorkgFloat := dmGlobal.GetCustoMedioKgInsumo(
        vIdInsumo,
        vIdFazenda, // Certifique-se de que este campo vem no JSON
        FormatDateTime('yyyy-mm-dd', Now) // ou outro campo que represente a data base
      );

      // Insere direto via SQL
      with dmGlobal.qryAux, dmGlobal.qryAux.SQL do
      begin
        Clear;
        Add('INSERT INTO DETALHES_FABRICA_RACAO (');
        Add('  ID, ID_CADASTRO_FABRICA_RACAO, ID_INSUMO,');
        Add('  QTDE_PREVISTA, QTDE_REALIZADA, ID_OPERADOR, MS_INSUMO, CUSTO_KG');
        Add(') VALUES (');
        Add('  :ID, :ID_CADASTRO_FABRICA_RACAO, :ID_INSUMO,');
        Add('  :QTDE_PREVISTA, :QTDE_REALIZADA, :ID_OPERADOR, :MS_INSUMO, :CUSTO_KG');
        Add(')');

        ParamByName('ID').AsString := Item.GetValue<string>('id', '');
        ParamByName('ID_CADASTRO_FABRICA_RACAO').AsString := Item.GetValue<string>('id_fabricacao', '');
        ParamByName('ID_INSUMO').AsString     := Item.GetValue<string>('id_insumo', '');
        ParamByName('QTDE_PREVISTA').AsFloat  := StrToFloatDef(Item.GetValue<string>('qtde_prevista', '0'), 0);
        ParamByName('QTDE_REALIZADA').AsFloat := StrToFloatDef(Item.GetValue<string>('qtd_realizada', '0'), 0);
        ParamByName('ID_OPERADOR').AsString   := Item.GetValue<string>('id_operador', '');
        ParamByName('MS_INSUMO').AsFloat      := StrToFloatDef(Item.GetValue<string>('ms_insumo', '0'), 0);
        ParamByName('CUSTO_KG').AsFloat       := vValorkgFloat;
//        ParamByName('DIF_KG').AsFloat         := vDif;
//        ParamByName('DIF_PER').AsFloat        := vDifPercent;

        try
         ExecSQL;
        except
          on e: Exception do
           Res.Send(TJSONObject.Create.AddPair('erro', E.Message)).Status(500);
        end;
      end;
    end;
    dmGlobal.AtualizaResumoFabricacao(Item.GetValue<string>('id_fabricacao', ''));
    Res.Send(TJSONObject.Create.AddPair('result', 'Itens inseridos com sucesso')).Status(200);
  except
    on E: Exception do
      Res.Send(TJSONObject.Create.AddPair('erro', E.Message)).Status(500);
  end;
end;

procedure PostFabricacao(Req: THorseRequest; Res: THorseResponse; Next: TProc);
var
  dmGlobal: TdmDB;
  Body: TJSONObject;
  JSONRetorno: TJSONObject;
  custo_kg_dietaS: string;
  custo_kg_dieta : Double;
  vMaxId, vTempStr: string;
  msRealizadaStr,KGRealizadaStr: string;
  msRealizada,KGRealizada: Double;
  FS: TFormatSettings;
begin
  FS := TFormatSettings.Create;
  FS.DecimalSeparator := ',';

  dmGlobal := TdmDB.Create(nil);
  Body := Req.Body<TJSONObject>;  // Body já pego

  try
    // Validação de campos obrigatórios
    if not Body.TryGetValue<string>('id', vMaxId) or (vMaxId.Trim = '') then
      raise Exception.Create('Campo obrigatório "id" não informado');

    if not Body.TryGetValue<string>('id_fazenda', vTempStr) or (vTempStr.Trim = '') then
      raise Exception.Create('Campo obrigatório "id_fazenda" não informado');

    if not Body.TryGetValue<string>('id_dieta', vTempStr) or (vTempStr.Trim = '') then
      raise Exception.Create('Campo obrigatório "id_dieta" não informado');

    custo_kg_dietaS := StringReplace(Body.GetValue<string>('custo_kg_dieta', '0'), '.', ',', [rfReplaceAll]);
    TryStrToFloat(custo_kg_dietaS, custo_kg_dieta);

    with dmGlobal.Fabricacao do
    begin
      Close;
      Open;
      Insert;
      FieldByName('ID').AsString := vMaxId;
      FieldByName('ID_FAZENDA').AsString := Body.GetValue<string>('id_fazenda', '');
      FieldByName('ID_DIETA').AsString := Body.GetValue<string>('id_dieta', '');

      if Body.TryGetValue<string>('data', vTempStr) and (vTempStr.Trim <> '') then
        FieldByName('DATA').AsString := vTempStr
      else
        FieldByName('DATA').Clear;

      msRealizadaStr := Body.GetValue<string>('ms_realizada', '0');
      if not TryStrToFloat(msRealizadaStr, msRealizada, FS) then
        msRealizada := 0;

      KGRealizadaStr := Body.GetValue<string>('qtde_realizada', '0');
      if not TryStrToFloat(KGRealizadaStr, KGRealizada, FS) then
        KGRealizada := 0;



      FieldByName('ID_USUARIO').AsString     := Body.GetValue<string>('id_usuario', '');
      FieldByName('ID_OPERADOR').AsString    := Body.GetValue<string>('id_operador', '');
      FieldByName('ID_VAGAO').AsString       := Body.GetValue<string>('id_vagao', '');
      FieldByName('QTDE_PREVISTA').AsString  := Body.GetValue<string>('qtd_prevista', '');
      FieldByName('MS_PREVISTA').AsString    := Body.GetValue<string>('ms_prevista', '');
      FieldByName('QTDE_PREVISTA').AsString  := Body.GetValue<string>('qtde_prevista', '');

      FieldByName('QTDE_REALIZADA').AsFloat  := KGRealizada;

      FieldByName('MS_BATIDA').AsFloat       := msRealizada;
      ApplyUpdates;
    end;

    // CRIA e ENVIA o JSON DEPOIS de tudo
    JSONRetorno := TJSONObject.Create;
    JSONRetorno.AddPair('id', vMaxId);

    Res.Send(JSONRetorno).Status(200);  // 🚨 depois do SEND não pode mais acontecer NADA

  except
    on E: Exception do
    begin
      JSONRetorno := TJSONObject.Create;
      JSONRetorno.AddPair('erro', E.Message);
      Res.Send(JSONRetorno).Status(500);
    end;
  end;

  // NÃO FAZ MAIS FREE depois do SEND
end;


end.
