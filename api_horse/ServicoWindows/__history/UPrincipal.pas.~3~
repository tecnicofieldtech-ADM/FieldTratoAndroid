unit UPrincipal;

interface

uses
  System.SysUtils, System.Classes, Vcl.SvcMgr,  Horse,
  Horse.Jhonson,
  System.Threading, System.Diagnostics, Windows,
  LoggerPro.GlobalLogger,Horse.CORS,Horse.HandleException,Horse.BasicAuthentication,
  Horse.Provider.IOHandleSSL;

type
  TApiRFeed = class(TService)
  procedure ServiceStart(Sender: TService; var Started: Boolean);
  private
    { Private declarations }
  public
    function GetServiceController: TServiceController; override;
    { Public declarations }
  end;

var
  ApiRFeed: TApiRFeed;

implementation

{$R *.dfm}

uses Controllers.Get, Controllers.Post;

procedure ServiceController(CtrlCode: DWord); stdcall;
begin
  ApiRFeed.Controller(CtrlCode);
end;

function TApiRFeed.GetServiceController: TServiceController;
begin
  Result := ServiceController;
end;

procedure LogEvent(const Msg: string);
var
  hEventLog: THandle;
begin
  hEventLog := RegisterEventSource(nil, 'ApiComboioMeireles');
  if hEventLog <> 0 then
  begin
    ReportEvent(hEventLog, EVENTLOG_ERROR_TYPE, 0, 0, nil, 1, 0, @PChar(Msg)^, nil);
    DeregisterEventSource(hEventLog);
  end;
end;


procedure TApiRFeed.ServiceStart(Sender: TService; var Started: Boolean);
begin
  try
    StartLogger;
    UControllers.RegistraRotas;
    GlobalLogger.Info('Serviço iniciado', '');
    // Inicia o servidor Horse em uma thread separada
    FServerThread := TTask.Run(
      procedure
      begin
        THorse.Use(Jhonson);
        THorse.Use(HorseBasicAuthentication(
         function(const AUsername, APassword: string): Boolean
          begin
            Result := AUsername.Equals('fuelmanage') and APassword.Equals('991528798');
          end)
         );
        THorse.Use(HandleException);
        THorse.Listen(9100);
      end
    );

    Started := True;
  except
    on E: Exception do
    begin
      LogEvent('Erro ao iniciar serviço: ' + E.Message);
      Started := False;
    end;
  end;
end;

end.
