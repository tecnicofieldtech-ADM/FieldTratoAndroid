// lib/features/fornecimento/domain/histerese_params.dart

class HistereseParams {
  const HistereseParams({
    required this.sMax,
    required this.alpha,
    required this.rup,
    required this.dBack,
    required this.tBackMs,
    required this.rUpBack,
  });

  final double sMax;
  final double alpha;
  final double rup;
  final double dBack;
  final int tBackMs;
  final double rUpBack;

  static const defaults = HistereseParams(
    sMax: 80.0,
    alpha: 0.35,
    rup: 120.0,
    dBack: 6.0,
    tBackMs: 900,
    rUpBack: 220.0,
  );
}
