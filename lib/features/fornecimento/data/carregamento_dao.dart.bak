// lib/features/fornecimento/data/carregamento_dao.dart
import "package:sqflite/sqflite.dart";
import "../../../db/app_db.dart";

class CarregamentoDao {
  Future<Database> get _db async => AppDb.instance.db;

  // ✅ nome correto da tabela
  static const _table = "CARREGAMENTO";

  /// Retorna o carregamento em aberto do vagão (STATUS = 0)
  Future<Map<String, Object?>?> getAbertoByVagao(String idVagao) async {
    final db = await _db;

    final rows = await db.query(
      _table,
      where: "ID_VAGAO = ? AND COALESCE(STATUS,0) = 0",
      whereArgs: [idVagao],
      orderBy: "DATA_REGISTRO DESC",
      limit: 1,
    );

    if (rows.isEmpty) return null;
    return rows.first;
  }

  /// Retorna carregamento em aberto vinculado a uma fabricação
  Future<Map<String, Object?>?> getAbertoByFabricacao(String idFabricacao) async {
    final db = await _db;

    final rows = await db.query(
      _table,
      where: "ID_FABRICACAO = ? AND COALESCE(STATUS,0) = 0",
      whereArgs: [idFabricacao],
      orderBy: "DATA_REGISTRO DESC",
      limit: 1,
    );

    if (rows.isEmpty) return null;
    return rows.first;
  }

  /// Retorna qualquer carregamento em aberto (caso especial/debug)
  Future<Map<String, Object?>?> getQualquerAberto() async {
    final db = await _db;

    final rows = await db.query(
      _table,
      where: "COALESCE(STATUS,0) = 0",
      orderBy: "DATA_REGISTRO DESC",
      limit: 1,
    );

    if (rows.isEmpty) return null;
    return rows.first;
  }
}
