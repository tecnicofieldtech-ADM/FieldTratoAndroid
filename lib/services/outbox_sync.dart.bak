import "dart:convert";

import "../db/app_db.dart";
import "../services/api_service.dart";

class OutboxSync {
  final ApiService api;

  OutboxSync({required this.api});

  // -------------------------
  // Helpers de formatação
  // -------------------------

  String _s(dynamic v) => (v ?? "").toString().trim();

  /// converte qualquer coisa para double de forma segura
  /// - aceita "99,00", "99.00", "1.234,56", "1,234.56"
  double _toDouble(dynamic v) {
    if (v == null) return 0;
    if (v is num) return v.toDouble();

    var t = v.toString().trim();
    if (t.isEmpty || t.toLowerCase() == "null") return 0;

    final hasComma = t.contains(",");
    final hasDot = t.contains(".");

    if (hasComma && hasDot) {
      // assume BR: "1.234,56"
      t = t.replaceAll(".", "").replaceAll(",", ".");
    } else if (hasComma) {
      // "12,34" -> "12.34"
      t = t.replaceAll(",", ".");
    }

    return double.tryParse(t) ?? 0;
  }

  /// Inteiro como string (Delphi mandava string)
  String _toBrIntStr(dynamic v) {
    final d = _toDouble(v);
    return d.round().toString();
  }

  /// Decimal como string com vírgula; se 0 manda "0"
  String _toBrDecStr(dynamic v, {int decimals = 2}) {
    final d = _toDouble(v);
    if (d == 0) return "0";
    final fixed = d.toStringAsFixed(decimals); // "99.00"
    return fixed.replaceAll(".", ","); // "99,00"
  }

  /// Converte "yyyy-mm-dd" (ou "yyyy-mm-ddTHH...") para "dd/mm/yyyy"
  String _toBrDate(dynamic v) {
    final t = _s(v);
    if (t.isEmpty) return "";
    final base = t.length >= 10 ? t.substring(0, 10) : t;

    if (base.length == 10 && base[2] == "/" && base[5] == "/") return base;

    if (base.length == 10 && base[4] == "-" && base[7] == "-") {
      final y = base.substring(0, 4);
      final m = base.substring(5, 7);
      final d = base.substring(8, 10);
      return "$d/$m/$y";
    }
    return t;
  }

  void _logJson(void Function(String) log, String label, Object obj) {
    try {
      log("$label ${jsonEncode(obj)}");
    } catch (_) {
      log("$label $obj");
    }
  }

  // ---------------------------------------------------------
  // 🔥 FIX: garante decimal em STRING no padrão BR (vírgula)
  // ---------------------------------------------------------

  // Chaves que precisam ir como número string PT-BR
  static const Set<String> _decimalKeys = {
    "qtde_prevista",
    "qtd_realizada",
    "ms_insumo",
    "realizado",
    "ms_dieta_realizada",
    "ms_prevista",
    "ms_realizada",
  };

  /// Converte strings numéricas para padrão BR:
  /// - "63.000" -> "63,000"
  /// - "1.234,56" -> "1234,56"
  /// - "1,234.56" -> "1234,56"
  String _fixDecimalPtBr(dynamic v) {
    if (v == null) return "0";
    if (v is num) {
      // se por algum motivo veio num, transforma em string BR
      return _toBrDecStr(v, decimals: 3);
    }

    var s = v.toString().trim();
    if (s.isEmpty || s.toLowerCase() == "null") return "0";

    // remove espaços
    s = s.replaceAll(" ", "");

    // se já tem vírgula e ponto, precisamos decidir qual é decimal:
    final hasComma = s.contains(",");
    final hasDot = s.contains(".");

    if (hasComma && hasDot) {
      // Se a vírgula vem depois do ponto: "1.234,56" -> BR (ponto milhar)
      // Se o ponto vem depois da vírgula: "1,234.56" -> EN (vírgula milhar)
      final lastComma = s.lastIndexOf(",");
      final lastDot = s.lastIndexOf(".");

      if (lastComma > lastDot) {
        // "1.234,56" -> remove milhar "." e mantém decimal ","
        s = s.replaceAll(".", "");
      } else {
        // "1,234.56" -> remove milhar "," e converte decimal "." -> ","
        s = s.replaceAll(",", "");
        s = s.replaceAll(".", ",");
      }
      return s;
    }

    if (hasDot && !hasComma) {
      // "63.000" -> "63,000"
      // (ou "12.34" -> "12,34")
      return s.replaceAll(".", ",");
    }

    // se só tem vírgula, já está BR
    return s;
  }

  /// Percorre Map/List e força as chaves decimais para PT-BR
  dynamic _fixBodyDecimals(dynamic node) {
    if (node is List) {
      return node.map(_fixBodyDecimals).toList();
    }
    if (node is Map) {
      final out = <String, dynamic>{};
      node.forEach((k, v) {
        final key = k.toString();
        if (_decimalKeys.contains(key)) {
          out[key] = _fixDecimalPtBr(v);
        } else {
          out[key] = _fixBodyDecimals(v);
        }
      });
      return out;
    }
    return node;
  }

  // -------------------------
  // 1) Sync GravaTag
  // -------------------------
  Future<void> syncGravaTag(void Function(String) log) async {
    final db = await AppDb.instance.db;
    final rows = await db.query("GRAVA_TAG", where: "SYNC = 0");

    for (final r in rows) {
      final idRow = _s(r["ID"]);
      final idCurral = _s(r["ID_PASTO_CURRAL"]);
      final tag = _s(r["TAG"]);

      if (idCurral.isEmpty || tag.isEmpty) {
        log("⚠️ GravaTag inválida (ID=$idRow) curral/tag vazio");
        continue;
      }

      final body = {
        "ID_PASTO_CURRAL": idCurral,
        "TAG": tag,
      };

      _logJson(log, "📤 /Post/GravaTag body=", body);

      final ok = await api.postGravaTag(body);

      if (ok && idRow.isNotEmpty) {
        await db.update(
          "GRAVA_TAG",
          {"SYNC": 1},
          where: "ID = ?",
          whereArgs: [idRow],
        );
        log("✅ GravaTag SYNC=1 ID=$idRow");
      } else {
        log("⚠️ Falha GravaTag ID=$idRow");
      }
    }
  }

  // -------------------------
  // 2) Sync Fabricação + Itens
  // -------------------------
  Future<void> syncFabricacao(void Function(String) log, String idVagaoCfg) async {
    final db = await AppDb.instance.db;

    final fab = await db.query(
      "CADASTRO_FABRICA_RACAO",
      where: "STATUS=1 AND IFNULL(QTD_REALIZADA,0)>0 AND IFNULL(FLAG_SYNC,0)=0",
    );

    for (final f in fab) {
      final idFabricacao = _s(f["ID"]);
      final idFazenda = _s(f["ID_FAZENDA"]);

      if (idFabricacao.isEmpty) {
        log("⏭️ Pulando fabricação sem ID");
        continue;
      }

      final kgReal = _toDouble(f["QTD_REALIZADA"]);
      if (kgReal <= 0) {
        log("⏭️ Pulando fab $idFabricacao: qtde_realizada=0");
        continue;
      }

      final payloadFab = <String, dynamic>{
        "id": idFabricacao,
        "id_fazenda": idFazenda,
        "id_dieta": _s(f["ID_DIETA"]),
        "data": _toBrDate(f["DATA_FABRICACAO"]),
        "id_usuario": _s(f["ID_USUARIO"]),
        "id_operador": _s(f["ID_OPERADOR"]),
        "id_vagao": idVagaoCfg,
        "qtde_prevista": _toBrIntStr(f["QTD_PREVISTA"]),
        "qtde_realizada": _toBrIntStr(f["QTD_REALIZADA"]),
        "ms_prevista": _toBrDecStr(f["MS_PREVISTA"], decimals: 2),
        "ms_realizada": _toBrDecStr(f["MS_REALIZADA"], decimals: 2),
      };

      // 🔥 garante vírgula mesmo se alguém mexer
      final payloadFabFixed = _fixBodyDecimals(payloadFab) as Map<String, dynamic>;

      _logJson(log, "📤 /Post/Fabricacao body=", payloadFabFixed);

      final okFab = await api.postFabricacao(payloadFabFixed, log: log);
      if (!okFab) {
        log("⚠️ Falha Fabricacao id=$idFabricacao");
        continue;
      }

      // -------------------------
      // ITENS (DETALHES_FABRICA_RACAO)
      // -------------------------
      final insumos = await db.query(
        "DETALHES_FABRICA_RACAO",
        where: "STATUS=1 AND ID_FABRICACAO=? AND IFNULL(FLAG_SYNC,0)=0",
        whereArgs: [idFabricacao],
      );

      log("🔎 insumos encontrados=${insumos.length} fab=$idFabricacao");

      if (insumos.isNotEmpty) {
        final itens = <Map<String, dynamic>>[];

        for (final i in insumos) {
          // 👇 tenta ler as colunas
          final rawPrev = i["QTD_PREVISTA"];
          final rawReal = i["QTD_REALIZADA"];
          final rawMs = i["MS_INSUMO"];

          final prevD = _toDouble(rawPrev);

          // não envia previsto=0
          if (prevD <= 0) {
            log("⏭️ Pulando insumo ${_s(i["ID"])}: prev<=0");
            continue;
          }

          // monta com BR
          final item = <String, dynamic>{
            "id": _s(i["ID"]),
            "id_fazenda": idFazenda,
            "id_fabricacao": idFabricacao,
            "id_insumo": _s(i["ID_INSUMO"]),

            // manda como string BR
            "qtde_prevista": _toBrDecStr(rawPrev, decimals: 3),
            "qtd_realizada": _toBrDecStr(rawReal, decimals: 3),
            "ms_insumo": _toBrDecStr(rawMs, decimals: 3),

            "id_operador": _s(i["ID_OPERADOR"]),
            "id_usuario": _s(i["ID_USUARIO"]),
          };

          itens.add(item);
        }

        if (itens.isNotEmpty) {
          final bodyItens = {"itens": itens};

          // 🔥 AQUI é o ponto crítico: força vírgula antes de enviar
          final bodyItensFixed = _fixBodyDecimals(bodyItens) as Map<String, dynamic>;

          _logJson(log, "📤 /Post/Fabricacao_Insumo body=", bodyItensFixed);

          final okItens = await api.postFabricacaoInsumo(bodyItensFixed, log: log);
          if (!okItens) {
            log("⚠️ Falha Fabricacao_Insumo id=$idFabricacao");
            continue;
          }
        } else {
          log("ℹ️ Nenhum insumo válido para enviar na fab $idFabricacao");
        }
      }

      await db.update(
        "CADASTRO_FABRICA_RACAO",
        {"FLAG_SYNC": 1},
        where: "ID=?",
        whereArgs: [idFabricacao],
      );
      await db.update(
        "DETALHES_FABRICA_RACAO",
        {"FLAG_SYNC": 1},
        where: "ID_FABRICACAO=?",
        whereArgs: [idFabricacao],
      );

      log("✅ FLAG_SYNC=1 fab $idFabricacao");
    }
  }

  // -------------------------
  // 3) Sync Fornecimento (agrupado)
  // -------------------------
  Future<void> syncFornecimento(void Function(String) log) async {
    final db = await AppDb.instance.db;

    final rows = await db.rawQuery('''
      SELECT
        cf.ID_FORNECIMENTO,
        MAX(cfr.ID_FAZENDA) AS id_fazenda,
        MAX(cf.ID_FABRICACAO) AS id_fabricacao,
        MAX(cf.ID_USUARIO) AS id_usuario_lancamento,
        MAX(cf.ID_USUARIO) AS id_tratador,
        MAX(cfr.ID_DIETA) AS id_dieta_realizada,
        SUM(cf.REALIZADO) AS realizado,
        AVG(cfr.MS_REALIZADA) AS ms_dieta_realizada
      FROM CADASTRO_FORNECIMENTO cf
      JOIN CADASTRO_FABRICA_RACAO cfr ON cfr.ID = cf.ID_FABRICACAO
      WHERE cf.REALIZADO > 0 AND IFNULL(cf.FLAG_SYNC,0) = 0
      GROUP BY cf.ID_FORNECIMENTO
    ''');

    final syncedIds = <String>{};

    for (final r in rows) {
      final idPrev = _s(r["ID_FORNECIMENTO"]);
      if (idPrev.isEmpty) {
        log("⚠️ Fornecimento sem ID_FORNECIMENTO (pular)");
        continue;
      }

      final payload = <String, dynamic>{
        "id": idPrev,
        "id_fabricacao": _s(r["id_fabricacao"]),
        "id_usuario_lancamento": _s(r["id_usuario_lancamento"]),
        "id_tratador": _s(r["id_tratador"]),
        "id_dieta_realizada": _s(r["id_dieta_realizada"]),
        "realizado": _toBrDecStr(r["realizado"], decimals: 3),
        "ms_dieta_realizada": _toBrDecStr(r["ms_dieta_realizada"], decimals: 3),
      };

      final payloadFixed = _fixBodyDecimals(payload) as Map<String, dynamic>;

      _logJson(log, "📤 /Post/Fornecimento body=", payloadFixed);

      final ok = await api.postFornecimento(payloadFixed);
      if (ok) {
        syncedIds.add(idPrev);
      } else {
        log("⚠️ Falha Fornecimento id=$idPrev");
      }
    }

    if (syncedIds.isNotEmpty) {
      final inArgs = syncedIds.map((_) => "?").join(",");
      await db.rawUpdate(
        "UPDATE CADASTRO_FORNECIMENTO SET FLAG_SYNC=1 WHERE ID_FORNECIMENTO IN ($inArgs)",
        syncedIds.toList(),
      );
      log("✅ ${syncedIds.length} fornecimento(s) marcado(s) FLAG_SYNC=1");
    }
  }
}
